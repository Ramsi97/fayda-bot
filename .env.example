# Telegram Bot Settings
TELEGRAM_TOKEN=your_bot_token_here
WEBHOOK_URL=https://your-webhook-domain.com
BOT_NAME=National ID converter

# Roles & Access
# SUPER_ADMIN_IDS: CSV list of Telegram user IDs who have full super admin access (first is primary).
# Fallback alias: AUTHORIZED_USER_IDS
SUPER_ADMIN_IDS=7790405623
AUTHORIZED_USER_IDS=7790405623

# VIP_IDS: CSV list of Telegram user IDs who can generate ID cards 100% FREE for themselves.
# They have NO reseller capabilities (no downline members, no /admin dashboard).
# VIP_IDS=11111111,22222222,33333333
VIP_IDS=

# SUPPORT_USERNAME: public Telegram @username shown to uninvited users when they
# open the bot without an access link (typically the super admin). The '@' is
# optional. Leave empty to show a generic "contact the administrator" message.
# Example: SUPPORT_USERNAME=FaydaSupport
SUPPORT_USERNAME=

# Postgres (Supabase) connection string.
# Local dev default below is a localhost Postgres. In production use your
# Supabase "Session pooler" URI (Project Settings → Database → Connection string
# → Session pooler), e.g.
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Pricing & Balance Defaults
PRICE_PER_DOWNLOAD=10
FREE_SIGNUP_BALANCE=0
ADMIN_CHAT_ID=0

DEBUG=false
LOG_LEVEL=INFO
